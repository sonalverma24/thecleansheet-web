{
  "manifest_version": 3,
  "name": "The Clean Sheet",
  "short_name": "CleanSheet",
  "version": "1.1.0",
  "description": "AI ingredient scorecard for any beauty product page. Get a safety score in seconds.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "The Clean Sheet - Analyse this product"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://thecleansheet.in/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.nykaa.com/*/p/*",
        "https://www.nykaa.com/p/*",
        "https://www.purplle.com/product/*",
        "https://www.amazon.in/*/dp/*",
        "https://www.amazon.in/dp/*",
        "https://www.flipkart.com/*/p/*",
        "https://www.myntra.com/*/*/*/buy"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
